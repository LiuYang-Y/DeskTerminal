<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 变体：侧栏玻璃透镜原型的预览入口。

  为什么要单独一页：透镜效果要改的是"侧栏选中指示块怎么画"，而真机上验它需要
  「左右两侧同时存在（验镜像）+ 能一键切回改动前的样式（验回归）+ 看得见当前设备的
  能力探测结果（API 30 上真折射是静默失效的）」。把这三件事塞进正式侧栏就等于
  在正式界面里留调试入口；单独一页则一处都不碰正式代码。

  release 构建不会包含本文件与对应 Activity。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      仅 debug：允许明文 HTTP（局域网开发服务器没有证书）。
      release 变体不包含本文件与这份配置 —— 见同目录下的 res/xml/network_security_config.xml。
    -->
    <application android:networkSecurityConfig="@xml/network_security_config">

        <!--
          folia-major Web 版可行性预览页：用真机 WebView 跑一遍，验渲染 / 帧率 / 播放 /
          后台 / 文件导入。同样只在 debug 变体里存在，不碰正式界面。
        -->
        <activity
            android:name=".debug.FoliaWebViewPreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:exported="true"
            android:label="folia Web 预览"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".debug.SidebarLensPreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:exported="true"
            android:label="侧栏透镜原型"
            android:screenOrientation="sensorLandscape" />

        <!--
          自适应框架调试页：显示设备档案 / 效果档位 / 运行时信号，
          并支持强制指定档位与模拟屏幕尺寸（应用内模拟，不动系统设置）。
          同样只在 debug 变体里存在。
        -->
        <activity
            android:name=".debug.AdaptiveDebugActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:exported="true"
            android:label="自适应框架调试"
            android:screenOrientation="sensorLandscape" />

    </application>

</manifest>
