<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
     前台服务：虚拟屏必须活在一个不受 Activity 重建影响的持有者里，所以放 Service。
     选 specialUse 是因为标准类型（mediaPlayback / connectedDevice / dataSync 等）
     没有一个对得上"把第三方应用画进自己的界面"这件事；Android 14+ 必须声明 subtype，
     否则 startForeground 直接被拒。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
     托管第三方应用需要的包可见性。
     targetSdk >= 30 上没有这段，PackageManager 查不到高德，
     会把"已安装"误判成"未安装"（:projection 那边为 DiPlay 踩过同一个坑）。
     只放行本轮实际托管的包，不用 QUERY_ALL_PACKAGES 那种宽口径。
    -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <!-- Shizuku 客户端要能查到 Shizuku 自身，用来区分"没装"和"没运行" -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application>

        <!--
         Shizuku 的 token 传递通道。
         没有它，Shizuku 无法把 binder（以及当前是 adb 还是 root 身份）交给我们进程，
         Shizuku.pingBinder() 会一直返回 false。
         authorities 必须落在 applicationId 下，否则 Shizuku 找不到我们。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
         虚拟屏持有者。不导出：它只服务本应用，Surface 也只能由本进程传进来。
        -->
        <service
            android:name=".VdHostService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="在自建虚拟屏上托管第三方应用，把它的画面画进本应用主界面" />
        </service>

    </application>

</manifest>
