<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
     托管第三方应用需要的包可见性。
     targetSdk >= 30 上没有这段，PackageManager 查不到高德，
     会把"已安装"误判成"未安装"（:projection 那边为 DiPlay 踩过同一个坑）。
     只放行本轮实际托管的包，不用 QUERY_ALL_PACKAGES 那种宽口径。
    -->
    <queries>
        <package android:name="com.autonavi.minimap" />
        <!-- Shizuku 客户端要能查到 Shizuku 自身 -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application>

        <!--
         Shizuku 的 token 传递通道。
         没有它，Shizuku 无法把 binder（以及当前是 adb 还是 root 身份）交给我们进程，
         Shizuku.pingBinder() 会一直返回 false。
         authorities 必须落在 applicationId 下，否则 Shizuku 找不到我们。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
         Q1 的实验探针：验证"普通应用能否创建承载第三方窗口的虚拟屏"。
         它只是一个带 logcat 输出的空 Activity，实验做完会删掉。
        -->
        <activity
            android:name=".probe.VdProbeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="VD Probe"
            android:screenOrientation="landscape" />

    </application>

</manifest>
